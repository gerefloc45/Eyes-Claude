{
  "name": "eyes-mcp-server",
  "version": "0.1.3",
  "description": "MCP server that gives Claude Code a browser to open, navigate and QA web apps for the Eyes plugin.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "npm run build && npm run bundle",
    "build": "tsc -p .",
    "bundle": "esbuild src/bundle-entry.ts --bundle --platform=node --format=cjs --outfile=dist/index.cjs --external:playwright --external:playwright-core --external:chromium-bidi",
    "test": "vitest run",
    "start": "node dist/index.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "playwright": "^1.47.0",
    "@axe-core/playwright": "^4.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.2"
  }
}
